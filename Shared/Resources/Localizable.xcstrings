    },
    "Tapping the widget opens this link, e.g. the store's app. Leave empty to open the card here." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknięcie widżetu otwiera ten link, np. aplikację sklepu. Zostaw puste, aby otwierać aplikację punktuj.se."
          }
        }
      }
    },
    "That code didn't work. Check the SMS and try again." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten kod nie zadziałał. Sprawdź SMS i spróbuj ponownie."
          }
        }
      }
    },
    "That code isn't a Żappka code." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
